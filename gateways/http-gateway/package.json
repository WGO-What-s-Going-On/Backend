{
  "name": "@wgo/http-gateway",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20 <27",
    "pnpm": ">=10"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fastify/cors": "11.3.0",
    "@fastify/helmet": "13.1.1",
    "@fastify/http-proxy": "11.6.2",
    "@fastify/rate-limit": "11.2.0",
    "fastify": "5.12.5",
    "ioredis": "6.0.0"
  },
  "devDependencies": {
    "@types/node": "26.6.2",
    "pino-pretty": "13.1.3",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vitest": "5.0.1"
  },
  "packageManager": "pnpm@10.33.0"
}
