NODE_ENV=development
HOST=127.0.0.1
PORT=8080
LOG_LEVEL=debug
LOG_PRETTY=true
BODY_LIMIT_BYTES=1048576

CORS_ORIGINS=http://localhost:3000,http://localhost:5173

RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000
REDIS_URL=redis://127.0.0.1:6379

UPSTREAM_REQUEST_TIMEOUT_MS=5000
UPSTREAM_MAX_RETRIES=1

USER_SERVICE_URL=http://127.0.0.1:3001
POST_SERVICE_URL=http://127.0.0.1:3002
MAP_SERVICE_URL=http://127.0.0.1:3003
NOTIFICATION_SERVICE_URL=http://127.0.0.1:3004
MODERATION_SERVICE_URL=http://127.0.0.1:3005
