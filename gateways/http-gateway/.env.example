NODE_ENV=development
HOST=127.0.0.1
PORT=8080
LOG_LEVEL=debug
LOG_PRETTY=true
BODY_LIMIT_BYTES=1048576

CORS_ORIGINS=http://localhost:3000,http://localhost:5173

RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000
REDIS_URL=redis://127.0.0.1:6379

UPSTREAM_REQUEST_TIMEOUT_MS=5000
UPSTREAM_MAX_RETRIES=1

USER_SERVICE_URL=http://127.0.0.1:3001
POST_SERVICE_URL=http://127.0.0.1:3002
MAP_SERVICE_URL=http://127.0.0.1:3003
NOTIFICATION_SERVICE_URL=http://127.0.0.1:3004
MODERATION_SERVICE_URL=http://127.0.0.1:3005

# Explicit local/dev opt-in. Ignored in production. Generate before visiting /docs.
DOCS_ENABLED=false
DOCS_FILE=generated/openapi.json
DOCS_FETCH_TIMEOUT_MS=5000

# User REST authentication: same HS256 user access settings as User Service.
# All unset: User routes return 503. Partial or invalid configuration fails startup.
# User, HTTP Gateway and WS Gateway must use identical JWT_ACCESS_SECRET/ISSUER/AUDIENCE.
JWT_ACCESS_SECRET=
JWT_ACCESS_ISSUER=
JWT_ACCESS_AUDIENCE=
# Gateway-only private P-256 JWK JSON with alg=ES256 and kid. Never share with User.
HTTP_GATEWAY_SERVICE_PRIVATE_JWK=

# Production Redis: rediss://:<percent-encoded-auth-token>@<primary-endpoint>:6379/0
# HTTP upstream variables accept only http:// or https:// (no Redis protocols).
# Use internal service DNS, e.g. POST_SERVICE_URL=http://post-service:3002.
