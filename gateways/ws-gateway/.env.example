NODE_ENV=development
HOST=127.0.0.1
PORT=8081
LOG_LEVEL=debug
LOG_PRETTY=true

WS_PATH=/ws/v1
WS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
WS_MAX_PAYLOAD_BYTES=65536
WS_HEARTBEAT_INTERVAL_MS=30000
WS_HEARTBEAT_TIMEOUT_MS=10000
WS_MAX_ROOMS_PER_SOCKET=50

JWT_SECRET=change-me-to-a-random-secret-at-least-32-bytes
JWT_ISSUER=wgo-user-service
JWT_AUDIENCE=wgo-realtime-gateway
JWT_COOKIE_NAME=wgo_access_token
