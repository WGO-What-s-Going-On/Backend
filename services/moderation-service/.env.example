NODE_ENV=development
PORT=3005

REDIS_URL=redis://localhost:6383
POST_EVENT_STREAM=post:events
MODERATION_EVENT_STREAM=moderation:events
MODERATION_CONSUMER_GROUP=post-moderation

OPENAI_API_KEY=
# Separate from moderation:events, which remains lifecycle-only.
MODERATION_CONTENT_EVENT_STREAM=moderation:content-events

# Reports require a separately provisioned Moderation PostgreSQL database.
# Never point this at User Service storage. TLS/CA/backup setup is an infra prerequisite.
MODERATION_REPORTS_DATABASE_URL=
REPORTS_POST_SERVICE_URL=
MODERATION_REPORT_EVENT_STREAM=moderation:report-events
MODERATION_HTTP_GATEWAY_TRUSTED_JWKS=
