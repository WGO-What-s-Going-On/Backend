NODE_ENV=development
PORT=3002
MONGODB_URI=mongodb://localhost:27017/wgo_post?replicaSet=rs0
REDIS_URL=redis://localhost:6380
WS_SERVICE_JWT_SECRET=change-me-to-a-separate-random-secret-at-least-32-bytes
WS_SERVICE_JWT_ISSUER=wgo-ws-gateway
WS_SERVICE_JWT_AUDIENCE=wgo-post-service
MAP_GRPC_ADDRESS=localhost:50051
MAP_GRPC_TIMEOUT_MS=500
# Retained for rollback to the previous HS256 Post version; current Post signing does not use it.
MAP_SERVICE_JWT_SECRET=change-me-to-a-different-random-secret-at-least-32-bytes
# JSON private P-256 JWK with alg=ES256, kid, kty=EC, crv=P-256, x, y, d. Inject as a secret after Map trusts the public key.
POST_SERVICE_SIGNING_JWK={"kid":"replace-with-key-id","alg":"ES256","kty":"EC","crv":"P-256","x":"replace-with-public-x","y":"replace-with-public-y","d":"replace-with-private-d"}
# Optional semantic search. Prepare pinned local model files before starting.
SEMANTIC_ENABLED=true
SEMANTIC_MODEL_ENABLED=true
SEMANTIC_MODEL_PATH=.cache/models/Xenova/multilingual-e5-small
SEMANTIC_WORKER_ENABLED=true
SEMANTIC_INDEX_ALIAS=post-semantic-e5-small-761b726-fp32-w480-o64-v1-read
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_TIMEOUT_MS=2000
# Set only after evaluating the real model; no production threshold default.
SEMANTIC_THRESHOLD=
# ELASTICSEARCH_API_KEY=

# Post event delivery and expiration. FAILED events require an operator retry.
OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_BATCH_SIZE=100
OUTBOX_MAX_ATTEMPTS=10
OUTBOX_REDIS_TIMEOUT_MS=2000
OUTBOX_LEASE_MS=30000
POST_EXPIRATION_POLL_INTERVAL_MS=1000
