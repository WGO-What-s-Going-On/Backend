NODE_ENV=development
PORT=3002
MONGODB_URI=mongodb://localhost:27017/wgo_post?replicaSet=rs0
REDIS_URL=redis://localhost:6380
WS_SERVICE_JWT_SECRET=change-me-to-a-separate-random-secret-at-least-32-bytes
WS_SERVICE_JWT_ISSUER=wgo-ws-gateway
WS_SERVICE_JWT_AUDIENCE=wgo-post-service
MAP_GRPC_ADDRESS=localhost:50051
MAP_GRPC_TIMEOUT_MS=500
# Retained for rollback to the previous HS256 Post version; current Post signing does not use it.
MAP_SERVICE_JWT_SECRET=change-me-to-a-different-random-secret-at-least-32-bytes
# JSON private P-256 JWK with alg=ES256, kid, kty=EC, crv=P-256, x, y, d. Inject as a secret after Map trusts the public key.
POST_SERVICE_SIGNING_JWK={"kid":"replace-with-key-id","alg":"ES256","kty":"EC","crv":"P-256","x":"replace-with-public-x","y":"replace-with-public-y","d":"replace-with-private-d"}
