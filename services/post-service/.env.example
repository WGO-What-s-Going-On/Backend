NODE_ENV=development
PORT=3002
MONGODB_URI=mongodb://localhost:27017/wgo_post?replicaSet=rs0
REDIS_URL=redis://localhost:6380
WS_SERVICE_JWT_SECRET=change-me-to-a-separate-random-secret-at-least-32-bytes
WS_SERVICE_JWT_ISSUER=wgo-ws-gateway
WS_SERVICE_JWT_AUDIENCE=wgo-post-service
MAP_GRPC_ADDRESS=localhost:50051
MAP_GRPC_TIMEOUT_MS=500
# Retained for rollback to the previous HS256 Post version; current Post signing does not use it.
MAP_SERVICE_JWT_SECRET=change-me-to-a-different-random-secret-at-least-32-bytes
# JSON private P-256 JWK with alg=ES256, kid, kty=EC, crv=P-256, x, y, d. Inject as a secret after Map trusts the public key.
POST_SERVICE_SIGNING_JWK={"kid":"replace-with-key-id","alg":"ES256","kty":"EC","crv":"P-256","x":"replace-with-public-x","y":"replace-with-public-y","d":"replace-with-private-d"}
# Optional semantic search. Prepare pinned local model files before starting.
SEMANTIC_ENABLED=true
SEMANTIC_MODEL_ENABLED=true
SEMANTIC_MODEL_PATH=.cache/models/Xenova/multilingual-e5-small
SEMANTIC_WORKER_ENABLED=true
SEMANTIC_INDEX_ALIAS=post-semantic-e5-small-761b726-fp32-w480-o64-v1-read
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_TIMEOUT_MS=2000
# ELASTICSEARCH_API_KEY=

# Post event delivery and expiration. FAILED events require an operator retry.
OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_BATCH_SIZE=100
OUTBOX_MAX_ATTEMPTS=10
OUTBOX_REDIS_TIMEOUT_MS=2000
OUTBOX_LEASE_MS=30000
POST_EXPIRATION_POLL_INTERVAL_MS=1000

# WS Gateway public JWK set, keys include iss=wgo-ws-gateway, alg=ES256, kid, kty=EC, crv=P-256, x,y; never d.
# Missing/invalid configuration fails closed on WS participation.
POST_WS_TRUSTED_JWKS=

# Enable after verifying Moderation's Redis endpoint/DB and retained events (group starts at 0).
POST_MODERATION_CONSUMER_ENABLED=false
# Same endpoint/DB as Moderation's REDIS_URL; independent of Post's outbound REDIS_URL.
MODERATION_REDIS_URL=redis://localhost:6383
MODERATION_EVENT_STREAM=moderation:events

# GKE MongoDB single-node replica set and ECK Elasticsearch use mounted public CAs.
# MONGODB_URI=mongodb://<user>:<percent-encoded-password>@mongodb-0.mongodb:27017/wgo_post?authSource=admin&tls=true&tlsCAFile=/app/certs/mongodb-ca.pem&replicaSet=rs0
# MONGODB_TLS_CA_SOURCE=file
# ELASTICSEARCH_URL=https://wgo-es-http:9200
# ELASTICSEARCH_API_KEY=<encoded-api-key>
# ELASTICSEARCH_TLS_CA_SOURCE=file
# NODE_EXTRA_CA_CERTS=/app/certs/elasticsearch-ca.pem
# file is the production default. For public trusted certificates use explicit system
# and omit that dependency's CA path. TLS and hostname verification remain enabled.
# Node reads NODE_EXTRA_CA_CERTS before application initialization.
# Docker includes the pinned model at /opt/wgo/models/e5, without runtime downloads.
# Model/CA validation runs in dist/start.js before dist/main.js.
# A disabled model is NOT search-ready; recommendations use the top three without a threshold.

# Private Cloud Storage media. ADC uses the Post GSA through Workload Identity.
GCS_MEDIA_ENABLED=false
# GCS_MEDIA_BUCKET=<private-media-bucket-name>
GCS_MEDIA_UPLOAD_TTL_SECONDS=300
GCS_MEDIA_READ_TTL_SECONDS=300
GCS_MEDIA_IMAGE_MAX_BYTES=10485760
GCS_MEDIA_VIDEO_MAX_BYTES=104857600
GCS_MEDIA_CLEANUP_INTERVAL_MS=60000
# Grant object read/write/delete and IAM signBlob on the signing service account.
# Do not inject GOOGLE_APPLICATION_CREDENTIALS or emulator overrides in production.

# Public HTTP Gateway ES256 JWK set; same issuer/key as USER_HTTP_GATEWAY_TRUSTED_JWKS.
POST_HTTP_GATEWAY_TRUSTED_JWKS=
# Distinct Moderation public ES256 key set for read-only report target verification.
POST_MODERATION_TRUSTED_JWKS=
USER_GRPC_ADDRESS=localhost:50052
# Post creation always requires Map ResolveRegion and its Kakao Local key.

# Content HIDE decisions: enable after deploying Post/Map/WS consumers and frontend hidden events.
POST_CONTENT_DECISION_CONSUMER_ENABLED=false
MODERATION_CONTENT_DECISION_STREAM=moderation:content-decisions
# Uses MODERATION_REDIS_URL above; approved policy is openai-flagged-hide-v1.
