{
  "openapi": "3.0.3",
  "info": {
    "title": "WGO Map Service HTTP API",
    "version": "1.0.0",
    "description": "Map Service\uc758 HTTP \uacc4\uc57d. \uc704\uce58 \uac31\uc2e0\uc740 \ud604\uc7ac \ub85c\uceec\u00b7\ud14c\uc2a4\ud2b8 \ud658\uacbd\uc5d0\uc11c\ub9cc \ub3d9\uc791\ud558\uba70 \uc6b4\uc601\uc5d0\uc11c\ub294 Gateway \uc0ac\uc6a9\uc790 \uc778\uc99d \uc5f0\ub3d9 \uc804\uae4c\uc9c0 503\uc744 \ubc18\ud658\ud569\ub2c8\ub2e4. gRPC\uc640 Redis Streams \uacc4\uc57d\uc740 \uc774 OpenAPI \ubb38\uc11c\uc758 \ubc94\uc704 \ubc16\uc785\ub2c8\ub2e4."
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "paths": {
    "/api/v1/location": {
      "put": {
        "tags": ["Location"],
        "summary": "\uc0ac\uc6a9\uc790 \uc704\uce58 \uac31\uc2e0 \uc774\ub825 \uae30\ub85d",
        "description": "\uc218\ub77d\ub41c \uc694\uccad\ub9c8\ub2e4 \ub3d9\uc77c \uc88c\ud45c\ub098 HTTP \uc7ac\uc2dc\ub3c4\ub3c4 \ubcc4\ub3c4 \uc774\ub825\uc73c\ub85c \uae30\ub85d\ud569\ub2c8\ub2e4. \uc11c\ubc84 \uc2dc\uac01\uc744 updatedAt\uc73c\ub85c \uc0ac\uc6a9\ud558\uba70 Cassandra \uc774\ub825\uc740 7\uc77c\uac04 \uc870\ud68c \uac00\ub2a5\ud569\ub2c8\ub2e4. X-User-Id\ub294 \ub85c\uceec\u00b7\ud14c\uc2a4\ud2b8 \uc804\uc6a9 \uc2dd\ubcc4\uc790\uc774\uba70 \uc6b4\uc601\uc5d0\uc11c\ub294 \uc774 \uc694\uccad\uc744 503\uc73c\ub85c \ucc28\ub2e8\ud569\ub2c8\ub2e4. Gateway\ub294 IP\ubcc4 \ucd5c\uadfc 60\ucd08 60\uac74\uc744 \ucd08\uacfc\ud558\uba74 Map\uc5d0 \uc804\ub2ec\ud558\uc9c0 \uc54a\uace0 Retry-After\uac00 \uc788\ub294 429\ub97c \ubc18\ud658\ud569\ub2c8\ub2e4.",
        "parameters": [
          {
            "name": "X-User-Id",
            "in": "header",
            "required": true,
            "description": "\uc591\uc758 \uc548\uc804 \uc815\uc218. \ub85c\uceec\u00b7\ud14c\uc2a4\ud2b8 \ud658\uacbd\uc5d0\uc11c\ub9cc \uc0ac\uc6a9\ud569\ub2c8\ub2e4.",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "example": 123
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LocationUpdate"
              },
              "example": {
                "latitude": 37.4979,
                "longitude": 127.0276
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Cassandra\uc5d0 \uc704\uce58 \uac31\uc2e0 \uc774\ub825 \uc800\uc7a5 \uc644\ub8cc",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Location"
                }
              }
            }
          },
          "400": {
            "description": "\ubcf8\ubb38 \ud06c\uae30 \ucd08\uacfc, \uc798\ubabb\ub41c JSON, \uc88c\ud45c \ubc94\uc704 \uc624\ub958 \ub610\ub294 \uc54c \uc218 \uc5c6\ub294 \ud544\ub4dc"
          },
          "403": {
            "description": "\ub85c\uceec\u00b7\ud14c\uc2a4\ud2b8 \ud658\uacbd\uc5d0\uc11c X-User-Id\uac00 \uc5c6\uac70\ub098 \uc720\ud6a8\ud558\uc9c0 \uc54a\uc74c"
          },
          "503": {
            "description": "\uc6b4\uc601 \ud658\uacbd\uc5d0\uc11c \uc778\uc99d \uc5f0\ub3d9 \uc804 \ucc28\ub2e8\ub418\uc5c8\uac70\ub098 \uc704\uce58 \uc800\uc7a5\uc18c\ub97c \uc0ac\uc6a9\ud560 \uc218 \uc5c6\uc74c"
          }
        }
      }
    },
    "/internal/v1/posts/nearby": {
      "get": {
        "tags": ["Posts"],
        "summary": "\uc8fc\ubcc0 ACTIVE \uac8c\uc2dc\ubb3c ID \uac80\uc0c9",
        "description": "Gateway \uc804\uc6a9 \ub0b4\ubd80 \uc870\ud68c\uc785\ub2c8\ub2e4. Map\uc5d0 \ubc18\uc601\ub41c \uc0c1\ud0dc\uac00 ACTIVE\uc774\uace0 \ub9cc\ub8cc\ub418\uc9c0 \uc54a\uc740 \uac8c\uc2dc\ubb3c\ub9cc \ubc18\ud658\ud569\ub2c8\ub2e4. \uac70\ub9ac\ub294 \uac80\uc0c9 \uc88c\ud45c\uc5d0\uc11c \uac8c\uc2dc\ubb3c \uc911\uc2ec\uae4c\uc9c0 \uce21\uc815\ud569\ub2c8\ub2e4. \uc0c1\ud0dc \uc774\ubca4\ud2b8 \ubc18\uc601\uc5d0\ub294 \uc9c0\uc5f0\uc774 \uc788\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4.",
        "security": [
          {
            "GatewayBearer": []
          }
        ],
        "parameters": [
          {
            "name": "latitude",
            "in": "query",
            "required": true,
            "schema": {
              "type": "number",
              "minimum": -90,
              "maximum": 90
            }
          },
          {
            "name": "longitude",
            "in": "query",
            "required": true,
            "schema": {
              "type": "number",
              "minimum": -180,
              "maximum": 180
            }
          },
          {
            "name": "radiusM",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer",
              "enum": [150, 250, 350]
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 20
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "description": "\uac80\uc0c9 \uc88c\ud45c\uc640 \ubc18\uacbd\uc5d0 \ubb36\uc778 \uc774\uc804 \uc751\ub2f5\uc758 nextCursor",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "\uac70\ub9ac, \ub3d9\uc77c \uac70\ub9ac\uc5d0\uc11c\ub294 postId \uc624\ub984\ucc28\uc21c",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NearbyResult"
                }
              }
            }
          },
          "400": {
            "description": "\uc798\ubabb\ub41c \uac80\uc0c9 \uc785\ub825 \ub610\ub294 \ucee4\uc11c"
          },
          "401": {
            "description": "Gateway JWT\uac00 \uc5c6\uac70\ub098 \uc720\ud6a8\ud558\uc9c0 \uc54a\uc74c"
          },
          "503": {
            "description": "Required Cassandra read failure or search budget exhausted. Budget failure returns {code: RESOURCE_EXHAUSTED}; no partial result."
          },
          "504": {
            "description": "Search deadline exceeded. Returns {code: DEADLINE_EXCEEDED}; no partial result."
          }
        }
      }
    },
    "/health/live": {
      "get": {
        "summary": "Map live probe",
        "responses": {
          "200": {
            "description": "Available"
          }
        }
      }
    },
    "/health/ready": {
      "get": {
        "summary": "Map ready probe",
        "responses": {
          "200": {
            "description": "Available"
          },
          "503": {
            "description": "Cassandra or Redis unavailable"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "GatewayBearer": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "HS256; issuer wgo-http-gateway; audience wgo-map-service; subject http-gateway; \ucd5c\ub300 \uc218\uba85 60\ucd08"
      }
    },
    "schemas": {
      "NearbyResult": {
        "type": "object",
        "required": ["items", "nextCursor"],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["postId", "distanceM"],
              "properties": {
                "postId": {
                  "type": "string"
                },
                "distanceM": {
                  "type": "number",
                  "minimum": 0
                }
              }
            }
          },
          "nextCursor": {
            "type": "string",
            "nullable": true
          }
        }
      },
      "LocationUpdate": {
        "type": "object",
        "additionalProperties": false,
        "required": ["latitude", "longitude"],
        "properties": {
          "latitude": {
            "type": "number",
            "minimum": -90,
            "maximum": 90,
            "example": 37.4979
          },
          "longitude": {
            "type": "number",
            "minimum": -180,
            "maximum": 180,
            "example": 127.0276
          }
        }
      },
      "Location": {
        "type": "object",
        "required": ["latitude", "longitude", "updatedAt"],
        "properties": {
          "latitude": {
            "type": "number",
            "example": 37.4979
          },
          "longitude": {
            "type": "number",
            "example": 127.0276
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time",
            "example": "2026-09-29T03:00:00.000Z"
          }
        }
      }
    }
  }
}
