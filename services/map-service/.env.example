NODE_ENV=development
HTTP_PORT=3003
GRPC_PORT=50051
CASSANDRA_HOST=localhost
CASSANDRA_DATACENTER=datacenter1
CASSANDRA_KEYSPACE=wgo_map
REDIS_URL=redis://localhost:6381
# For Post Service integration, use its Redis instance (typically redis://localhost:6380).
MAP_SERVICE_JWT_SECRET=change-me-to-a-different-random-secret-at-least-32-bytes
# JSON JWKS: keys contain iss=wgo-post-service, kid, alg=ES256, kty=EC, crv=P-256, x, y. Deploy before switching Post signing.
MAP_SERVICE_TRUSTED_JWKS={"keys":[{"iss":"wgo-post-service","kid":"replace-with-key-id","alg":"ES256","kty":"EC","crv":"P-256","x":"replace-with-public-x","y":"replace-with-public-y"}]}
MAP_GATEWAY_JWT_SECRET=change-me-to-a-separate-random-secret-at-least-32-bytes
