NODE_ENV=development
PORT=3004
REDIS_URL=redis://localhost:6382
DB_CONNECTION_MODE=direct
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=wgo_notification
DB_USER=wgo
DB_PASSWORD=wgo
DB_TLS_MODE=disable
DB_POOL_MAX=10
# Direct production connections require verify-full. Omit CA path for system CAs.
# DB_TLS_CA_PATH=/app/certs/postgres.pem
# GKE uses DB_CONNECTION_MODE=cloud-sql-proxy, DB_HOST=127.0.0.1,
# DB_TLS_MODE=disable, DB_USER=<notification GSA IAM DB username>, no DB_PASSWORD.
# The automatic IAM proxy sidecar encrypts and authenticates the remote connection.

# GKE uses ADC from Workload Identity. Grant the Notification GSA
# roles/firebasecloudmessaging.admin on the target Firebase project.
# Omit BOTH client email and private key to use ADC.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# HTTP OpenAPI: http://localhost:3004/docs/openapi.json (Swagger UI: /docs)
# Public HTTP Gateway ES256 JWK set. Never use a user access JWT secret here.
NOTIFICATION_HTTP_GATEWAY_TRUSTED_JWKS=
