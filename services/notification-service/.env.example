NODE_ENV=development
PORT=3004

REDIS_URL=redis://localhost:6382

AWS_REGION=ap-northeast-2
DYNAMODB_ENDPOINT=http://127.0.0.1:8002
DYNAMODB_NOTIFICATIONS_TABLE=notifications
DYNAMODB_PUSH_SUBSCRIPTIONS_TABLE=push-subscriptions
DYNAMODB_EVENT_STATE_TABLE=notification-event-state

FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# HTTP OpenAPI: http://localhost:3004/docs/openapi.json (Swagger UI: /docs)
# Gateway collection reuses this service URL; no extra documentation service.
