{
  "name": "@wgo/user-service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=10 <11"
  },
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "migration:run": "nest build && typeorm migration:run -d dist/database/data-source.js",
    "migration:revert": "nest build && typeorm migration:revert -d dist/database/data-source.js",
    "migration:show": "nest build && typeorm migration:show -d dist/database/data-source.js",
    "seed:terms": "nest build && node dist/database/seeds/seed-terms.js"
  },
  "dependencies": {
    "@nestjs/common": "12.0.4",
    "@nestjs/config": "12.0.0",
    "@nestjs/core": "12.0.4",
    "@nestjs/platform-express": "12.0.4",
    "@nestjs/typeorm": "12.0.1",
    "ioredis": "5.8.2",
    "jose": "6.1.0",
    "pg": "8.23.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "typeorm": "1.1.1"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.3",
    "@nestjs/testing": "12.0.4",
    "@types/node": "26.6.2",
    "@types/supertest": "7.2.1",
    "supertest": "7.2.2",
    "typescript": "6.0.3",
    "vitest": "5.0.1"
  },
  "packageManager": "pnpm@10.33.0"
}
