NODE_ENV=development
PORT=3001

DB_HOST=localhost
DB_PORT=5432
DB_USER=wgo
DB_PASSWORD=wgo
DB_NAME=wgo_user

REDIS_URL=redis://localhost:6379
OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_BATCH_SIZE=20
OUTBOX_REDIS_TIMEOUT_MS=2000
WITHDRAWAL_POLL_INTERVAL_MS=60000
WITHDRAWAL_BATCH_SIZE=20

USER_GRPC_HOST=127.0.0.1
USER_GRPC_PORT=50052
USER_GRPC_PACKAGE=wgo.user.v1
USER_GRPC_PROTO_PATH=contracts/user.proto
# Legacy HS256 shared secret; keep only during the service-auth migration.
USER_SERVICE_JWT_SECRET=change-me-to-a-different-random-secret-at-least-32-bytes
# JSON JWKS: keys contain iss=wgo-post-service, kid, alg=ES256, kty=EC, crv=P-256, x, y. Never include d.
USER_SERVICE_TRUSTED_JWKS={"keys":[{"iss":"wgo-post-service","kid":"replace-with-key-id","alg":"ES256","kty":"EC","crv":"P-256","x":"replace-with-public-x","y":"replace-with-public-y"}]}

KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=

JWT_ACCESS_SECRET=
JWT_ACCESS_ISSUER=
JWT_ACCESS_AUDIENCE=
JWT_ACCESS_TTL_SECONDS=
JWT_REFRESH_TTL_SECONDS=

TERMS_SERVICE_DOCUMENT_URL=
TERMS_PRIVACY_DOCUMENT_URL=
TERMS_LOCATION_DOCUMENT_URL=
