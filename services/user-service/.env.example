NODE_ENV=development
PORT=3001

DB_HOST=localhost
DB_PORT=5432
DB_USER=wgo
DB_PASSWORD=wgo
DB_NAME=wgo_user
# GKE uses a same-Pod Cloud SQL Auth Proxy with --auto-iam-authn.
# Set DB_CONNECTION_MODE=cloud-sql-proxy, DB_HOST=127.0.0.1, DB_USER to the IAM DB user.
# Set DB_NAME=wgo_user and omit DB_PASSWORD and DB_TLS_CA_* in proxy mode.
DB_CONNECTION_MODE=direct
DB_POOL_MAX=10

REDIS_URL=redis://localhost:6379
OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_BATCH_SIZE=20
OUTBOX_REDIS_TIMEOUT_MS=2000
WITHDRAWAL_POLL_INTERVAL_MS=60000
WITHDRAWAL_BATCH_SIZE=20
REWARDS_POLL_INTERVAL_MS=1000
REWARDS_PENDING_IDLE_MS=30000
REWARDS_MAX_ATTEMPTS=5
# Leave unset until the reward policy is approved. See REWARDS_CONTRACT.md.
USER_REWARD_POLICY_JSON=

USER_GRPC_HOST=127.0.0.1
USER_GRPC_PORT=50052
USER_GRPC_PACKAGE=wgo.user.v1
USER_GRPC_PROTO_PATH=contracts/user.proto
# Legacy HS256 shared secret; keep only during the service-auth migration.
USER_SERVICE_JWT_SECRET=change-me-to-a-different-random-secret-at-least-32-bytes
# JSON JWKS: keys contain iss=wgo-post-service, kid, alg=ES256, kty=EC, crv=P-256, x, y. Never include d.
USER_SERVICE_TRUSTED_JWKS={"keys":[{"iss":"wgo-post-service","kid":"replace-with-key-id","alg":"ES256","kty":"EC","crv":"P-256","x":"replace-with-public-x","y":"replace-with-public-y"}]}

KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=http://localhost:5173/auth/kakao/callback

# User, HTTP Gateway and WS Gateway must use identical JWT_ACCESS_SECRET/ISSUER/AUDIENCE.
JWT_ACCESS_SECRET=
JWT_ACCESS_ISSUER=
JWT_ACCESS_AUDIENCE=
JWT_ACCESS_TTL_SECONDS=
JWT_REFRESH_TTL_SECONDS=

TERMS_SERVICE_DOCUMENT_URL=https://wgo-what-s-going-on.github.io/Frontend/terms/service.html
TERMS_PRIVACY_DOCUMENT_URL=https://wgo-what-s-going-on.github.io/Frontend/terms/privacy.html
TERMS_LOCATION_DOCUMENT_URL=https://wgo-what-s-going-on.github.io/Frontend/terms/location.html
TERMS_VERSION=1.0
TERMS_EFFECTIVE_AT=2026-09-01T00:00:00.000Z

# HTTP OpenAPI: http://localhost:3001/docs/openapi.json (Swagger UI: /docs)
# Gateway collection reuses this service URL; no extra documentation service.

# Required for REST startup; separate from Post->User gRPC trusted keys.
# Public JWK set: each key has iss=wgo-http-gateway, alg=ES256, kid, kty=EC, crv=P-256, x, y; no d.
USER_HTTP_GATEWAY_TRUSTED_JWKS=

# Direct production connections require verify-full. Proxy loopback connections use disable.
DB_TLS_MODE=disable
# Required only with verify-full; no default, no insecure mode.
# DB_TLS_CA_PATH=/app/certs/postgres-ca.pem

# Shared parent domain only when HTTP and WS use different subdomains.
AUTH_COOKIE_DOMAIN=

# Private profile bucket; ADC / Workload Identity only. No service account JSON key.
GCS_PROFILE_ENABLED=false
GCS_PROFILE_BUCKET=

# Confirmed titles run independently of the default-off credit policy.
USER_TITLES_ENABLED=true
USER_REGIONAL_RANKING_ENABLED=true
# Actual Post candidate.regionCode / vote.regionCode snapshots. Use none to pause regional ranking.
USER_TITLE_REGION_CONTRACT=vote-region-v1
# Distinct Notification public ES256 key set for read-only bilateral block checks.
USER_NOTIFICATION_TRUSTED_JWKS=
