# GitHub Environment Variables, independently configured in staging and production.
# No AWS credentials or GCP service account JSON keys are used.
GCP_WORKLOAD_IDENTITY_PROVIDER=projects/123456789/locations/global/workloadIdentityPools/wgo-staging-github/providers/github
GCP_DEPLOY_SERVICE_ACCOUNT=wgo-staging-deploy@replace-project-id.iam.gserviceaccount.com
# Both environments use the same Artifact Registry repository to promote the exact digest.
# Each environment uses its own namespace, Cloud SQL instance, secret identity and domains.
GCP_ENV_JSON={"project":"replace-project-id","region":"asia-northeast3","cluster":"wgo-demo","namespace":"wgo-staging","registry":"asia-northeast3-docker.pkg.dev/replace-project-id/wgo","sqlInstance":"replace-project-id:asia-northeast3:wgo-demo","domain":"api.example.com","wsDomain":"ws.example.com","staticIp":"wgo-staging-ingress","secretVersion":"1","replicas":1,"webOrigins":["https://demo.example.com"]}
CD_BUILD_CONCURRENCY=2
CD_DEPLOY_CONCURRENCY=4
# Comma-separated app names or all. Forces rollout, not an unnecessary rebuild.
CD_FORCE_SERVICES=
# Runtime secrets live in Secret Manager and are mounted by the Pod's service account.
# Pin numeric secretVersion and deploy after rotation. Never put secret values into GCP_ENV_JSON.
# Keep main PR protection and required CI. Both environments restrict deployments to main.
# production must have required reviewers. workflow_dispatch bootstraps staging only.
