# This is a GitHub Secrets inventory, NOT an application dotenv file and NOT loaded by CD.
# Copy each NAME=value into Settings -> Secrets and variables -> Actions -> Secrets.
# JSON examples must be replaced with real single-line JSON; do not commit populated copies.
# No AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY: Actions uses OIDC.

# CD runs only when a PR is merged into main. CI runs only on PR open/update/reopen.
# There is no CD_BRANCH secret or manual workflow_dispatch trigger.
# main branch protection must require PRs and successful ci; enable strict/up-to-date checks.

# The following REQUIRED secrets exist independently in GitHub Environments staging and production.
# Configure production required reviewers + both environments' deployment branch restriction to main.
# Initial implementation shares the SAME ECR registry/region/repository names between environments;
# ECS clusters, target account roles and runtime values can differ if cross-account ECR pull is configured.
AWS_REGION=ap-northeast-2
AWS_ACCOUNT_ID=123456789012
AWS_ROLE_ARN=arn:aws:iam::123456789012:role/github-wgo-staging-deploy
ECR_REGISTRY=123456789012.dkr.ecr.ap-northeast-2.amazonaws.com
ECS_CLUSTER=wgo-staging
CD_IMAGE_PLATFORM=linux/amd64
# Existing SSM parameter path prefix. State is written to <prefix>/<environment>/<service-name>.
# First deployment does not require existing parameters, but GetParameters/PutParameter IAM is required.
CD_STATE_PREFIX=/wgo/deployments

# REQUIRED JSON map: keys are selected application names (same set in both environments).
# Names: user-service,map-service,post-service,notification-service,moderation-service,http-gateway,ws-gateway.
# Only configured services are released; start with one service if bootstrapping.
# Each taskDefinition is full register-task-definition input, with an essential named app container,
# awsvpc/FARGATE, cpu/memory/executionRoleArn, LINUX runtimePlatform matching CD_IMAGE_PLATFORM,
# healthCheck, portMappings and CloudWatch logConfiguration. App image is replaced by digest.
# runtimeSecretArn points to an EXISTING per-service Secrets Manager secret, never a shared application secret.
# Optional fields: migrationCommand (argv array), smokeCommand (argv array), smokeUrl (HTTPS health URL).
# migrationCommand runs once in Fargate before updating the service; smokeCommand after stable deployment.
# Omit migrationCommand for services without a reviewed idempotent schema migration.
# Existing ECS service supplies subnets/security groups/assignPublicIp for one-off tasks.
CD_SERVICES_JSON={"user-service":{"ecrRepository":"wgo/user-service","ecsService":"wgo-user-staging","containerName":"app","runtimeSecretArn":"arn:aws:secretsmanager:ap-northeast-2:123456789012:secret:wgo/staging/user-REPLACE","migrationCommand":["node","node_modules/typeorm/cli.js","migration:run","-d","dist/database/data-source.js"],"taskDefinition":{"family":"wgo-user-staging","networkMode":"awsvpc","requiresCompatibilities":["FARGATE"],"cpu":"256","memory":"512","executionRoleArn":"arn:aws:iam::123456789012:role/wgo-task-execution","taskRoleArn":"arn:aws:iam::123456789012:role/wgo-user-task","runtimePlatform":{"cpuArchitecture":"X86_64","operatingSystemFamily":"LINUX"},"containerDefinitions":[{"name":"app","essential":true,"image":"replaced-by-cd","portMappings":[{"containerPort":3001},{"containerPort":50052}],"healthCheck":{"command":["CMD","node","-e","fetch('http://127.0.0.1:3001/health/live').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"],"interval":30,"timeout":5,"retries":3,"startPeriod":60},"logConfiguration":{"logDriver":"awslogs","options":{"awslogs-group":"/ecs/wgo-user-staging","awslogs-region":"ap-northeast-2","awslogs-stream-prefix":"app"}}}]}}}

# REQUIRED JSON map with exactly the runtime values for each configured application.
# CD writes each map to its existing runtimeSecretArn, then pins that VersionId in the ECS task secrets.
# No secret values enter Docker build args, image layers, release artifact or workflow output.
# Every value MUST be a string, NODE_ENV MUST be production. Set Gateway HOST=0.0.0.0.
# Fill all service-specific required settings from services/<name>/.env.example or gateways/<name>/.env.example.
# User auth secrets below are placeholders, not valid keys. Nested JWK/JWKS values must be JSON-escaped strings.
CD_RUNTIME_SECRETS_JSON={"user-service":{"NODE_ENV":"production","PORT":"3001","DB_HOST":"replace-private-postgres-host","DB_PORT":"5432","DB_TLS_MODE":"verify-full","DB_TLS_CA_PATH":"/app/certs/rds-global-bundle.pem","DB_USER":"replace","DB_PASSWORD":"replace","DB_NAME":"wgo_user","REDIS_URL":"rediss://:replace-percent-encoded-auth-token@replace-private-redis:6379/0","KAKAO_REST_API_KEY":"replace","KAKAO_CLIENT_SECRET":"replace","KAKAO_REDIRECT_URI":"https://replace/auth/callback","JWT_ACCESS_SECRET":"replace-with-strong-shared-user-access-secret","JWT_ACCESS_ISSUER":"wgo-user-service","JWT_ACCESS_AUDIENCE":"wgo-api","JWT_ACCESS_TTL_SECONDS":"900","JWT_REFRESH_TTL_SECONDS":"86400","USER_GRPC_HOST":"0.0.0.0","USER_SERVICE_TRUSTED_JWKS":"{\"keys\":[\"replace-with-post-service-public-jwk\"]}","USER_HTTP_GATEWAY_TRUSTED_JWKS":"{\"keys\":[\"replace-with-http-gateway-public-jwk\"]}"}}

# Runtime key coordination when adding the other services to BOTH JSON maps:
# http-gateway: JWT_ACCESS_SECRET/ISSUER/AUDIENCE match User, HTTP_GATEWAY_SERVICE_PRIVATE_JWK private P-256 key.
# user-service: USER_HTTP_GATEWAY_TRUSTED_JWKS contains matching Gateway public JWK only.
# ws-gateway: WS_SERVICE_PRIVATE_JWK private P-256 key used for Post internal HTTP calls.
# post-service: POST_WS_TRUSTED_JWKS contains matching WS public JWK only.
# Never reuse user Access JWT keys as service signing keys.
# WS user Access JWT issuer/algorithm compatibility remains a separate production-readiness prerequisite.

# OPTIONAL GitHub Secret in BOTH environments (or inherited repository Secret):
# Comma-separated configured service names, or all; normally leave empty.
# For secret/task-only changes, set this before merging a release-note PR into main, then clear after success.
CD_FORCE_SERVICES=
# GitHub provides GITHUB_TOKEN/RUN_ID/RUN_ATTEMPT/REPOSITORY/EVENT_PATH; do not create secrets for them.

# User Aurora Express: DB_AUTH_MODE=iam, AWS_REGION, DB_USER=<IAM database role>,
# DB_TLS_MODE=verify-full, DB_TLS_CA_SOURCE=system; omit DB_PASSWORD and DB_TLS_CA_PATH.
# User task role needs rds-db:connect restricted to dbuser:<cluster-resource-id>/<DB_USER>.
# Tokens are generated per new connection; never store a generated token in this JSON.
# Post runtime values inside CD_RUNTIME_SECRETS_JSON["post-service"]:
# POST_MODERATION_CONSUMER_ENABLED="true" enables the existing Moderation lifecycle consumer.
# MODERATION_REDIS_URL="rediss://<moderation-stream-endpoint>:6379" must match Moderation's endpoint/DB.
# MODERATION_EVENT_STREAM="moderation:events" must match the producer stream name.
# Default is disabled; inspect retained BOARD_CLOSED events before first enablement (group starts at 0).

# User Access JWT: identical JWT_ACCESS_SECRET, JWT_ACCESS_ISSUER and JWT_ACCESS_AUDIENCE
# in CD_RUNTIME_SECRETS_JSON for user-service, http-gateway and ws-gateway only.
# WS no longer uses JWT_SECRET/JWT_ISSUER/JWT_AUDIENCE/JWT_JWKS_URL.
# Preserve the existing User values during rollout; service ES256 keys remain separate.

# Optional map-service entries in CD_RUNTIME_SECRETS_JSON (string values):
# MAP_NEARBY_TIMEOUT_MS="500", MAP_NEARBY_MAX_QUERIES="4500",
# MAP_NEARBY_MAX_CANDIDATES="2000", MAP_NEARBY_READ_TIMEOUT_MS="250".
# Map rejects invalid limits at startup; these do not increase Post MAP_GRPC_TIMEOUT_MS.

# AWS storage overlay examples (merge into existing per-service runtime maps, all values strings).
# Complete variable requirements, CA volume task definition, IAM and blockers:
# docs/deployment/aws-storage.md. These are placeholders, not deployable credentials.
# user-service: DB_TLS_MODE="verify-full", DB_TLS_CA_PATH="/app/certs/rds-global-bundle.pem"
# map-service: CASSANDRA_MODE="keyspaces", CASSANDRA_HOST="<keyspaces-dns>",
#   CASSANDRA_PORT="9142", CASSANDRA_KEYSPACE="<existing-keyspace>",
#   CASSANDRA_DATACENTER="ap-northeast-2", AWS_REGION="ap-northeast-2",
#   CASSANDRA_CA_PATH="/app/certs/keyspaces-bundle.pem"
# post-service: MONGODB_URI="mongodb://<user>:<encoded-password>@<cluster-dns>:27017/wgo_post?tls=true&tlsCAFile=/app/certs/rds-global-bundle.pem&replicaSet=rs0&readPreference=primary&retryWrites=false",
#   ELASTICSEARCH_URL="https://<certificate-san-dns>:9200", ELASTICSEARCH_API_KEY="<encoded-api-key>",
#   NODE_EXTRA_CA_CERTS="/app/certs/elasticsearch-ca.pem", SEMANTIC_MODEL_PATH="/opt/wgo/models/e5",
#   SEMANTIC_ENABLED="true", SEMANTIC_MODEL_ENABLED="true"
#   SEMANTIC_THRESHOLD: add ONLY the evaluated value; no production default.
# notification-service: AWS_REGION="ap-northeast-2", DYNAMODB_NOTIFICATIONS_TABLE="<actual-table>",
#   DYNAMODB_PUSH_SUBSCRIPTIONS_TABLE="<actual-table>", DYNAMODB_EVENT_STATE_TABLE="<actual-table>"
#   Omit DYNAMODB_ENDPOINT and credential overrides in production.
# Event participants: REDIS_URL="rediss://:<encoded-auth-token>@<primary-endpoint>:6379/0"
#   MODERATION_REDIS_URL (Post) must match Moderation REDIS_URL including DB.
# HTTP Gateway: HOST="0.0.0.0", USER_SERVICE_URL="http://user-service:3001",
#   POST_SERVICE_URL="http://post-service:3002", MAP_SERVICE_URL="http://map-service:3003",
#   NOTIFICATION_SERVICE_URL="http://notification-service:3004", MODERATION_SERVICE_URL="http://moderation-service:3005"
# Post: MAP_GRPC_ADDRESS="map-service:50051"
# Certificate contents never enter build args. Supply read-only /app/certs task volume.
# GitHub AWS_REGION is NOT automatically an application variable: add it to Map/Notification maps.
